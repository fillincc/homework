class Human:
    def __init__(self, name, age):
        self.name = name
        self.age = age

    def introduce(self):
        print("Мене звати", self.name)
        print("Мені", self.age, "років")


class Sim(Human):
    def __init__(self, name, age):
        super().__init__(name, age)
        self.happiness = 50
        self.money = 100

    def play(self):
        self.happiness += 10
        print(self.name, "грає. Щастя:", self.happiness)

    def work(self):
        self.money += 50
        print(self.name, "працює. Гроші:", self.money)


sim1 = Sim("Alex", 20)
sim2 = Sim("Sofia", 19)

sim1.introduce()
sim1.play()
sim1.work()

print()

sim2.introduce()
sim2.play()
sim2.work()
